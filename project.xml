<?xml version="1.0" encoding="utf-8"?>
<project>

	<meta title="SideWinder" package="com.sample.sidewinder" version="1.0.0" company="Company Name" />
	<app main="Main" path="Export" file="SideWinder" />

	<source path="Source" />
	<source path="client/Source" />
	<!-- SIDEWINDER-CORE-HYGIENE-S1: Main/LoadTest/TestDB and the demo+test
	     packages moved here so they are NOT exported by haxelib.json's
	     classPath ("Source"). A library must not put a root-level `Main` on
	     every consumer's classpath. This project.xml still builds them. -->
	<source path="dev/Source" />
	
	<haxelib name="lime" />
    <haxelib name="haxe-injection"/>
    <haxelib name="hxwell" />
    <haxedef name="disable_env" />
	<assets path="static" />
    <assets path="migrations" />
	

	
</project>